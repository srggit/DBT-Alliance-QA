                SELECT Id, Proposal_Status__c
                FROM Proposal__c
                WHERE Id = :req.proposalId
                LIMIT 1
            ];

            if (!submittedCheck.isEmpty()
                && submittedCheck[0].Proposal_Status__c != PROPOSAL_STATUS_DRAFT) {

                List<Scheme_Section__c> sectionsToClose = [
                    SELECT Id, Reopen_Status__c,Application_Stages__c
                    FROM Scheme_Section__c
