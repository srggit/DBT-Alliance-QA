<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_date_is_of_Today</name>
        <label>Check date is of Today</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Scheme_Start_Today_sDate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fx_IsDateToday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Shortlisted_Proposals_to_Draft</targetReference>
            </connector>
            <label>Scheme Start Today&apos;sDate</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Date</name>
        <dataType>Date</dataType>
        <expression>Today()</expression>
    </formulas>
    <formulas>
        <name>fx_IsDateToday</name>
        <dataType>Boolean</dataType>
        <expression>DATEVALUE({!$Record.Second_Stage_Start_Date__c}) = TODAY()</expression>
    </formulas>
    <interviewLabel>SchedularFlowToUpdateProposal {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SchedularFlowToUpdateProposal</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Shortlisted_Proposals_to_Draft</name>
        <label>Update Shortlisted Proposals to Draft</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Yearly_Scheme__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Proposal_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Shortlisting</stringValue>
            </value>
        </filters>
        <filters>
            <field>Eligible_For_Full__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Eligible</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Peer_Application_Stage__c</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <object>Proposal__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_date_is_of_Today</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Second_Stage_End_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Yearly_Schemes__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-08-27</startDate>
            <startTime>12:14:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>ProposalRecord</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Proposal__c</objectType>
    </variables>
    <variables>
        <name>YearlySchemeIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
