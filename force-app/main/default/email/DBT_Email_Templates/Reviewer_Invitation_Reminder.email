<html>
    <body style="margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, Helvetica, sans-serif">
        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="background-color: #f4f4f4; padding: 24px 0"
        >
            <tr>
                <td align="center">
                    <table
                        role="presentation"
                        width="600"
                        cellpadding="0"
                        cellspacing="0"
                        style="background-color: #ffffff; border: 1px solid #e0e0e0"
                    >
                        <tr>
                            <td style="background: linear-gradient(135deg, #8b1e3f 0%, #5c1029 100%); background-color: #8b1e3f; padding: 20px 32px">
                                <span style="color: #ffffff; font-size: 20px; font-weight: bold">DBT Alliance</span>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 32px; color: #333333; font-size: 14px; line-height: 1.6">
                                <p style="margin-top: 0">Dear {!Reviewer_Mapping__c.Reviewer_Name__c},</p>

                                <p>
                                    This is a friendly reminder that you were invited to review a proposal for
                                    DBT Alliance, and we have not yet received your response.
                                </p>

                                <p><strong>Invitation details:</strong></p>
                                <table
                                    role="presentation"
                                    cellpadding="6"
                                    cellspacing="0"
                                    style="border-collapse: collapse; margin: 12px 0"
                                >
                                    <tr>
                                        <td
                                            style="
                                                color: #666666;
                                                width: 110px;
                                                white-space: nowrap;
                                                vertical-align: top;
                                            "
                                        >
                                            Proposal ID:
                                        </td>
                                        <td style="color: #333333">{!Reviewer_Mapping__c.Proposal_Id__c}</td>
                                    </tr>
                                    <tr>
                                        <td
                                            style="
                                                color: #666666;
                                                width: 110px;
                                                white-space: nowrap;
                                                vertical-align: top;
                                            "
                                        >
                                            Scheme:
                                        </td>
                                        <td style="color: #333333">{!Reviewer_Mapping__c.Scheme_Name__c}</td>
                                    </tr>
                                    <tr>
                                        <td
                                            style="
                                                color: #666666;
                                                width: 110px;
                                                white-space: nowrap;
                                                vertical-align: top;
                                            "
                                        >
                                            Application Stage:
                                        </td>
                                        <td style="color: #333333">{!Reviewer_Mapping__c.Application_Stages__c}</td>
                                    </tr>
                                    <tr>
                                        <td
                                            style="
                                                color: #666666;
                                                width: 110px;
                                                white-space: nowrap;
                                                vertical-align: top;
                                            "
                                        >
                                            Reviewer Type:
                                        </td>
                                        <td style="color: #333333">{!Reviewer_Mapping__c.Reviewer_Type__c}</td>
                                    </tr>
                                    <tr>
                                        <td
                                            style="
                                                color: #666666;
                                                width: 110px;
                                                white-space: nowrap;
                                                vertical-align: top;
                                            "
                                        >
                                            Status:
                                        </td>
                                        <td style="color: #333333">{!Reviewer_Mapping__c.Status__c}</td>
                                    </tr>
                                    <tr>
                                        <td
                                            style="
                                                color: #666666;
                                                width: 110px;
                                                white-space: nowrap;
                                                vertical-align: top;
                                            "
                                        >
                                            Invited On:
                                        </td>
                                        <td style="color: #333333">{!Reviewer_Mapping__c.Invitation_Sent_Date__c}</td>
                                    </tr>
                                    <tr>
                                        <td
                                            style="
                                                color: #666666;
                                                width: 110px;
                                                white-space: nowrap;
                                                vertical-align: top;
                                            "
                                        >
                                            Review Deadline:
                                        </td>
                                        <td style="color: #333333">{!Reviewer_Mapping__c.Deadline_Date__c}</td>
                                    </tr>
                                </table>

                                <p>
                                    Please log in to the DBT Alliance portal at your earliest convenience to accept
                                    or decline this review invitation.
                                </p>

                                <p>
                                    If you believe you have received this message in error, please contact our
                                    support team.
                                </p>

                                <p style="margin-bottom: 0">
                                    Regards,<br />
                                    DBT Alliance Team
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td style="background-color: #f0f0f0; padding: 16px 32px; color: #999999; font-size: 11px">
                                This is an automated message. Please do not reply directly to this email.
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>