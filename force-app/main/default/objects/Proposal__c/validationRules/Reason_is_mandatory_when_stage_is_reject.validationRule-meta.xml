<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reason_is_mandatory_when_stage_is_reject</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
  ISPICKVAL(Proposal_Status__c, &quot;Rejected&quot;), 
  ISBLANK(TRIM(Reason_for_Rejection__c)) 
)</errorConditionFormula>
    <errorMessage>Reason for Rejection is required for rejected proposals.</errorMessage>
</ValidationRule>
