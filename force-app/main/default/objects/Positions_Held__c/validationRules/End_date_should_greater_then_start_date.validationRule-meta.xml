<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_date_should_greater_then_start_date</fullName>
    <active>true</active>
    <errorConditionFormula>Date_From__c &gt;= Date_To__c</errorConditionFormula>
    <errorDisplayField>Date_To__c</errorDisplayField>
    <errorMessage>End should be greater then start date.</errorMessage>
</ValidationRule>
