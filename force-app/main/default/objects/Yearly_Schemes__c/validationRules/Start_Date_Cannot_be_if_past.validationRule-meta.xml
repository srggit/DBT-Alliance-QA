<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Start_Date_Cannot_be_if_past</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  OR(ISNEW(), ISCHANGED(Scheme_Start_Date__c)),
  Scheme_Start_Date__c &lt; NOW()
)</errorConditionFormula>
    <errorMessage>Start Date cannot be in the past.</errorMessage>
</ValidationRule>
