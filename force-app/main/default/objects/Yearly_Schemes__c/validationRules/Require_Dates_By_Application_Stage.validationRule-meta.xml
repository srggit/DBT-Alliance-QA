<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Dates_By_Application_Stage</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Scheme_Start_Date__c)),
  NOT(ISBLANK(Scheme_End_Date__c)),
  Scheme_End_Date__c &lt; Scheme_Start_Date__c
)</errorConditionFormula>
    <errorMessage>Scheme End Date Cannot be past of Scheme Start date</errorMessage>
</ValidationRule>
