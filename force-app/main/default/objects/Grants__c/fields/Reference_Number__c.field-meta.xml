<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reference_Number__c</fullName>
    <externalId>false</externalId>
    <formula>IF(RecordType.DeveloperName =&apos;CRC&apos;, &apos;IA&apos; + &apos;/&apos; + &apos;CRC&apos; + &apos;/&apos; 
			+RIGHT(TEXT(YEAR(DATEVALUE(CreatedDate))),2) + &apos;/&apos; + &apos;1&apos;+&apos;/&apos;+Reference__c,
IF(RecordType.DeveloperName =&apos;Team_Science_Grants_TSG&apos;,&apos;IA&apos; + &apos;/&apos; + &apos;TSG&apos; + &apos;/&apos; 
			+RIGHT(TEXT(YEAR(DATEVALUE(CreatedDate))),2)+ &apos;/&apos; + &apos;1&apos; + &apos;/&apos; +Reference__c,&apos;0&apos;))</formula>
